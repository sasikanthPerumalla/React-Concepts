{
  "name": "MyOrg_MyLibrary_WeatherWidget",
  "label": "Weather Widget",
  "description": "A simple weather display component showing temperature, condition, location, and humidity",
  "organization": "MyOrg",
  "version": "1.0.0",
  "library": "MyLibrary",
  "componentKey": "MyOrg_MyLibrary_WeatherWidget",
  "allowedApplications": [],
  "type": "Widget",
  "subtype": "CASE",
  "icon": "cloud",
  "properties": [
    {
      "name": "heading",
      "label": "Heading",
      "format": "TEXT",
      "required": true
    },
    {
      "name": "locationProperty",
      "label": "Location Property",
      "format": "TEXT"
    },
    {
      "name": "temperatureProperty",
      "label": "Temperature Property",
      "format": "TEXT"
    },
    {
      "name": "conditionProperty",
      "label": "Condition Property",
      "format": "TEXT"
    },
    {
      "name": "humidityProperty",
      "label": "Humidity Property",
      "format": "TEXT"
    },
    {
      "name": "temperatureUnit",
      "label": "Temperature Unit",
      "format": "SELECT",
      "source": [
        {
          "key": "C",
          "value": "Celsius"
        },
        {
          "key": "F",
          "value": "Fahrenheit"
        }
      ]
    },
    {
      "name": "visibility",
      "label": "Visible",
      "format": "VISIBILITY"
    },
    {
      "label": "Advanced",
      "format": "GROUP",
      "collapsible": true,
      "properties": [
        {
          "name": "testId",
          "label": "Test ID",
          "format": "TEXT",
          "ignorePattern": "[^-_\\p{N}\\p{L}]",
          "includeAnnotations": false
        }
      ]
    }
  ],
  "defaultConfig": {
    "label": "Weather Widget",
    "detailFVLItem": true,
    "isFormWidth": false,
    "isContainerWidth": false
  }
}
